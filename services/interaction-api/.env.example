# Defaults for all of these live in nitro.config.ts (`runtimeConfig`); the names
# below override them, as does the NITRO_-prefixed form (NITRO_MOCK_SERVICE_URL).

# Base URL of the mock service (external dependency)
MOCK_SERVICE_URL=http://localhost:8080
# Timeout for each upstream request in milliseconds
UPSTREAM_TIMEOUT_MS=2000
# How long an upstream read is cached, in seconds (catalog and ingredient lists)
CACHE_TTL_SECONDS=30
# Minimum log severity: debug | info | warn | error ("debug" adds one line per
# upstream read; an unrecognised value falls back to info)
LOG_LEVEL=info
